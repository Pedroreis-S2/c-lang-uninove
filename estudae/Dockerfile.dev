# syntax=docker/dockerfile:1

# Imagem de DESENVOLVIMENTO: SDK do Flutter + artefatos web ja baixados.
# O `flutter precache --web` roda no BUILD da imagem, entao `flutter run`
# nao baixa o Web SDK toda vez que o container sobe.
ARG FLUTTER_VERSION=3.24.5
FROM ghcr.io/cirruslabs/flutter:${FLUTTER_VERSION}

RUN flutter config --no-analytics \
 && flutter precache --web

WORKDIR /workspaces/estudae
CMD ["sleep", "infinity"]
