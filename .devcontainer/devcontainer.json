{
  "name": "uni9 (estudae + uninoVet)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "forwardPorts": [3000, 8080, 5000],
  "portsAttributes": {
    "3000": { "label": "UninoVet - porta unica (app + clinica + API)", "onAutoForward": "openBrowser" },
    "8080": { "label": "UninoVet - aplicacao da clinica (Java)", "onAutoForward": "notify" },
    "5000": { "label": "App Flutter (Estudae ou UninoVet)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "anthropic.claude-code"
      ]
    }
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code || true",
  "postAttachCommand": "echo 'Rode:  make uninovet   OU   make estudae   (um por vez). Abra as portas na aba PORTS.'"
}
