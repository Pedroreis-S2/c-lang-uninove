{
  "name": "UninoVet",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "mobile",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [5000, 8080, 3306],
  "portsAttributes": {
    "5000": { "label": "App Flutter", "onAutoForward": "openPreview" },
    "8080": { "label": "Painel Java", "onAutoForward": "notify" },
    "3306": { "label": "MySQL", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  }
}
